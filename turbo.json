{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AUTH_SECRET",
    "DATABASE_URL",
    "JWT_SECRET",
    "LOGTO_APP_ID",
    "LOGTO_APP_SECRET",
    "LOGTO_BASE_URL",
    "LOGTO_COOKIE_SECRET",
    "LOGTO_MANAGEMENT_APP_ID",
    "LOGTO_MANAGEMENT_APP_SECRET",
    "LOGTO_ORGANIZATION_ID",
    "LOGTO_ADMIN_ROLE_ID",
    "LOGTO_INSTANCE_LEAD_ROLE_ID",
    "TALLY_FORM_ID",
    "TALLY_WEBHOOK_SECRET",
    "TALLY_FIELD_KEYS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
