# Required at startup and build time. Fill in .env.local; never commit real values.
DATABASE_URL=
# tekID (Pocket ID) OpenID Connect client for this origin.
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=http://dot-wtf.localhost:1355
# Generate with: openssl rand -hex 32
LOGTO_COOKIE_SECRET=
# tekID issuer. Defaults to https://auth.mules.wtf; set it to point at another provider.
TEKID_ISSUER=https://auth.mules.wtf
# tekID admin API key (header X-API-KEY). Approving a public application creates
# the applicant's tekID account with it. Without it, review reports 503 and
# approves nothing. Not needed to build or to run the public site read-only.
TEKID_API_KEY=
# tekID group every approved member joins, so other club services can authorize
# on the groups claim. Created on first approval if it does not exist.
TEKID_MEMBER_GROUP=members
# Lifetime of the one-time sign-in link shown to the reviewer after approval.
TEKID_LINK_TTL=12h
# Where /join photos are written. A bind mount in the container (entrypoint.sh
# chowns it), a local directory in development.
UPLOADS_DIR=./.uploads
UPLOADS_MAX_BYTES=5000000
# tekID handles sign-in only. Membership and roles live in DATABASE_URL.
# Optional legacy Tally export settings (the live webhook is retired).
TALLY_FORM_ID=lbp7OX
TALLY_WEBHOOK_SECRET=
# Public machine keys/ID for form lbp7OX. Keep the signing secret separate.
TALLY_FIELD_KEYS={"name":"question_QBV8a7","email":"question_9JQ2gQ","whatsapp":"question_exR9je","categories":"question_WpzlkN","otherCategory":"question_ardZPB","wtfIdea":"question_6QNrzk","currentProject":"question_79x4gZ","youtubeLink":"question_b4dNEL","otherCategoryOptionId":"784fb875-8f79-40a3-acf7-286060fc241b"}

# One-time migration operator only; not required by the application runtime.
# Used by pnpm import:logto-members (dry run) or the explicit --apply mode.
# Keep these in the operator environment, not the deployed app.
# LOGTO_MANAGEMENT_APP_ID=
# LOGTO_MANAGEMENT_APP_SECRET=
# LOGTO_ORGANIZATION_ID=
# LOGTO_ADMIN_ROLE_ID=
# LOGTO_INSTANCE_LEAD_ROLE_ID=
