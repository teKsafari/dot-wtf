# Required at startup and build time. Fill in .env.local; never commit real values.
DATABASE_URL=
# tekID / Logto: use the dot-wtf Traditional web application.
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=http://dot-wtf.localhost:1355
# Generate with: openssl rand -hex 32
LOGTO_COOKIE_SECRET=
# Separate Machine-to-machine application with Logto Management API access.
LOGTO_MANAGEMENT_APP_ID=
LOGTO_MANAGEMENT_APP_SECRET=
# This site's organization and its two User organization roles.
LOGTO_ORGANIZATION_ID=
# ID of dot-wtf:admin (the app keeps the local alias "admin").
LOGTO_ADMIN_ROLE_ID=
# ID of dot-wtf:instance-lead (the app keeps the local alias "instance-lead").
LOGTO_INSTANCE_LEAD_ROLE_ID=
TALLY_FORM_ID=lbp7OX
TALLY_WEBHOOK_SECRET=
