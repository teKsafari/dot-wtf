# Required at startup and build time. Fill in .env.local; never commit real values.
DATABASE_URL=
# tekID / Logto: use the dot-wtf Traditional web application.
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=http://dot-wtf.localhost:1355
# Generate with: openssl rand -hex 32
LOGTO_COOKIE_SECRET=
# Logto handles sign-in only. Membership and roles live in DATABASE_URL.
# Optional legacy Tally export settings (the live webhook is retired).
TALLY_FORM_ID=lbp7OX
TALLY_WEBHOOK_SECRET=
# Public machine keys/ID for form lbp7OX. Keep the signing secret separate.
TALLY_FIELD_KEYS={"name":"question_QBV8a7","email":"question_9JQ2gQ","whatsapp":"question_exR9je","categories":"question_WpzlkN","otherCategory":"question_ardZPB","wtfIdea":"question_6QNrzk","currentProject":"question_79x4gZ","youtubeLink":"question_b4dNEL","otherCategoryOptionId":"784fb875-8f79-40a3-acf7-286060fc241b"}

# One-time migration operator only; not required by the application runtime.
# Used by pnpm import:logto-members (dry run) or the explicit --apply mode.
# Keep these in the operator environment, not the deployed app.
# LOGTO_MANAGEMENT_APP_ID=
# LOGTO_MANAGEMENT_APP_SECRET=
# LOGTO_ORGANIZATION_ID=
# LOGTO_ADMIN_ROLE_ID=
# LOGTO_INSTANCE_LEAD_ROLE_ID=
